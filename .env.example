DATABASE_URL="postgresql://athar:athar_dev_pw@localhost:5432/athar_dev?schema=public"

PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# سرّ توقيع منفصل تماماً لبوابة الموظف (تطبيق الجوال) — يجب أن يختلف عن JWT_ACCESS_SECRET
JWT_EMPLOYEE_PORTAL_SECRET="change-me-employee-portal-secret"
JWT_EMPLOYEE_PORTAL_EXPIRES_IN="7d"

# رقم سري افتراضي لأي مستأجر جديد لفك ترحيل المعاملات (يمكن تغييره من الإعدادات)
DEFAULT_UNLOCK_PIN="1234"

# التخزين السحابي للمرفقات (Cloudflare R2 — متوافقة مع S3 API). اختيارية في التطوير المحلي؛
# رفع/عرض/حذف المرفقات (وإنشاء قيود من مستندات) يفشل بخطأ واضح فقط عند استخدامها فعلياً
# بدون ضبطها، دون التأثير على باقي النظام.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# مطلوب فقط لميزة "إنشاء قيد من مستند" بالذكاء الاصطناعي (POST /api/journal-entries/from-document)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# مطلوب فقط لربط فاتورة (ZATCA) — تشفير أسرار CSID لكل شركة (src/lib/zatca/secretBox.ts).
# 32 بايت (256 بت) مُرمّزة بـ base64، تُولَّد بـ:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ZATCA_ENCRYPTION_KEY=

# مطلوب فقط لتوليد PDF/A-3 لفواتير زاتكا (src/lib/zatca/pdf/renderPdf.ts) — مسار ثنائي Chromium/
# Chrome قابل للتنفيذ مثبَّت في بيئة النشر (يختلف حسب البيئة، لا قيمة افتراضية عالمية).
CHROMIUM_EXECUTABLE_PATH=

# مطلوب فقط لتفعيل مسارات /api/platform-admin/* (يستخدمها تطبيق "athar-platform-admin" المنفصل
# تماماً — مستودع كود وقاعدة بيانات مستقلَّين — لإدارة الاشتراكات/الموديولات/الإشعارات من خارج هذا
# النظام، بلا أي اتصال مباشر بقاعدة البيانات بين النظامين). بدونه، هذه المسارات ترفض كل الطلبات.
# 32 بايت عشوائية مُرمَّزة بـ base64، تُولَّد بـ:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATFORM_ADMIN_API_KEY=

# مطلوب لإرسال كل إيميلات النظام فعلياً (ترحيب عند التسجيل، دعوة مستخدم جديد، إرسال فاتورة
# للعميل) عبر Resend (https://resend.com/api-keys). بدونه، src/lib/mailer.ts يكتفي بطباعة كل
# إيميل في الـ logs بدل إرساله — النظام يعمل بلا أخطاء ظاهرة لكن بلا أي إيميل حقيقي يصل لأحد.
RESEND_API_KEY=

# عنوان "من" لكل الإيميلات الصادرة، بصيغة Name <email@domain.com>. لازم يكون من دومين موثَّق
# (Verified) في لوحة Resend — Domains ← Add Domain ← أضف سجلات DNS (SPF/DKIM) عند مزوّد الدومين.
# بدون ضبطه، يُستخدَم onboarding@resend.dev الافتراضي — عنوان Resend التجريبي المُقيَّد رسمياً:
# يقدر يوصّل فقط لإيميل صاحب حساب Resend نفسه، وليس لأي عميل أو مستخدم حقيقي آخر.
EMAIL_FROM_ADDRESS=

# أصل الواجهة الأمامية المنشورة فعلياً (بدون شرطة مائلة في النهاية) — تُبنى عليه كل الروابط
# داخل الإيميلات (تفعيل الدعوة، إعادة تعيين كلمة المرور). يجب أن يطابق الدومين الفعلي للواجهة.
FRONTEND_BASE_URL=
