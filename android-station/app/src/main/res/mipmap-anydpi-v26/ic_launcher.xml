<?xml version="1.0" encoding="utf-8"?>
<!-- أيقونة تكيّفية (Adaptive Icon، أندرويد 8+) — خلفية مسطّحة (ic_launcher_background) + مقدّمة
     شعار أثر (ic_launcher_foreground)، وطبقة أحادية اللون (ic_launcher_monochrome) لأيقونات
     أندرويد 13+ المُموضَعة (themed icons). راجع assets/brand/generate_android_station_icons.py (سكربت
     التوليد) لكيفية اشتقاق الطبقات من assets/brand/generated/athar-mark-transparent.png (ملوَّن معكوساً + شارة مضخة). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
