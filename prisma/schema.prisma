  horseId           String
  horse             Horse                  @relation(fields: [horseId], references: [id])
  stallId           String?
  stall             StableStall?           @relation(fields: [stallId], references: [id])
  startDate         DateTime
  endDate           DateTime?
  monthlyFee        Decimal                @db.Decimal(18, 2)
  depositAmount     Decimal?               @db.Decimal(18, 2)
  contractNumber    String?
  ownerName         String?
  ownerNationality  String?
  ownerNationalId   String?
