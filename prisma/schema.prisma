// ============================================================================
// مخطط قاعدة البيانات — نظام أثر المحاسبي
// المرحلة صفر: كل الجداول موثّقة هنا وفق القسم 4 من ATHAR_BACKEND_SPEC.md
// (لتكون الأساس الجاهز لكل المراحل القادمة)، لكن الـ API المبني فعلياً في
// هذه المرحلة يغطي فقط: المصادقة، الشركات، شجرة الحسابات، مراكز التكلفة،
// القيود اليومية، والتقارير المالية الثلاثة.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 4.1 المستأجرون والمستخدمون
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  basic
  professional
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  subscriptionPlan   SubscriptionPlan   @default(basic)
  subscriptionStatus SubscriptionStatus @default(trialing)
  trialEndsAt        DateTime?
  unlockPin          String // قيمة مُشفّرة بـ bcrypt دائماً (انظر hashPassword في auth.service.ts)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users            User[]
  companies        Company[]
  costCenters      CostCenter[]
  accounts         Account[]
  companyDocuments CompanyDocument[]
  leaseContracts   LeaseContract[]
  journalEntries   JournalEntry[]
  auditLogs        AuditLog[]

  customers        Customer[]
  quotations       Quotation[]
  salesInvoices    SalesInvoice[]
  invoiceEmailLogs InvoiceEmailLog[]
  reportSchedules  ReportSchedule[]
  salesReturns     SalesReturn[]
  salesDebitNotes  SalesDebitNote[]
  receipts         Receipt[]
  stationSales     StationSale[]

  suppliers        Supplier[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]

  items          Item[]
  itemComponents ItemComponent[]
  warehouses     Warehouse[]
  stockMovements StockMovement[]

  fixedAssets      FixedAsset[]
  assetCategories  AssetCategory[]
  depreciationRuns DepreciationRun[]

  employees                 Employee[]
  leaveSettlements          LeaveSettlement[]
  hrActions                 HrAction[]
  payrollRuns               PayrollRun[]
  attendanceRecords         AttendanceRecord[]
  payrollComponents         PayrollComponent[]
  employeePayrollComponents EmployeePayrollComponent[]
  payrollSettings           PayrollSettings[]
  employeeAdvances          EmployeeAdvance[]

  attachments Attachment[]

  @@map("tenants")
}

enum UserRole {
  super_admin // مدير عام — الحساب الرئيسي المالك فقط، غير قابل للمنح عبر الدعوة العادية
  admin // مدير النظام
  finance_manager // مدير مالي
  accountant // محاسب
  hr_manager // مسؤول موارد بشرية
  viewer // مشاهدة فقط
}

enum InviteStatus {
  pending
  accepted
}

model User {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  email           String       @unique
  passwordHash    String?
  role            UserRole     @default(accountant)
  companyScope    String       @default("all") // "all" أو معرّف شركة محددة ضمن المستأجر
  active          Boolean      @default(true)
  inviteStatus    InviteStatus @default(accepted)
  inviteToken     String?      @unique
  inviteExpiresAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("refresh_tokens")
}

// رمز استعادة كلمة المرور — يُخزَّن مجزّأً (SHA-256) لا كنص خام، بنفس أسلوب RefreshToken،
// أحادي الاستخدام (usedAt) ومحدود الصلاحية (expiresAt)، ويُستخدم أيضاً لتطبيق تحديد معدل
// الطلبات (٣ طلبات لكل بريد إلكتروني في الساعة) بعدّ الصفوف المُنشأة حديثاً لنفس المستخدم.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// سجل تدقيق فك الترحيل وأي أحداث حساسة أخرى — غير موجود في البروتوتايب، مطلوب في القسم 4.9
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // مثال: "journal_entry.unpost"
  entityType String // مثال: "JournalEntry"
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 4.2 الشركات والإعدادات
// ---------------------------------------------------------------------------

model Company {
  id                       String                @id @default(cuid())
  tenantId                 String
  tenant                   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                     String
  shortName                String?
  logoKey                  String?
  brandColor               String?
  vatNumber                String?
  crNumber                 String?
  crIssueDate              DateTime?
  crExpiryDate             DateTime?
  officialEmail            String?
  phone                    String?
  addressBuilding          String?
  addressStreet            String?
  addressDistrict          String?
  addressCity              String?
  addressPostalCode        String?
  addressAdditionalNo      String?
  // بادئة ترقيم القيود التسلسلي لهذه الشركة؛ تبدأ افتراضياً بالحرف J ويمكن تعديلها من بيانات الشركة.
  numberingPrefix          String                @default("J")
  // العدّاد التالي في تسلسل هذه الشركة تحديداً (يبدأ من 1، مستقل تماماً عن باقي الشركات) — يُزاد
  // ذرّياً (UPDATE ... RETURNING ضمن نفس معاملة إنشاء القيد) فقط لحظة الحفظ الفعلي، لا عند مجرد
  // فتح نافذة الإضافة أو معاينة الرقم التالي، تجنباً لفجوات Gaps بسبب عمليات مُلغاة.
  nextJournalEntrySeq      Int                   @default(1)
  // إعدادات تنبيهات الداشبورد المالية — قابلة للتعديل لكل شركة من الإعدادات
  vatFilingFrequency       VatFilingFrequency    @default(quarterly)
  zakatDeclarationDueDate  DateTime?
  lowCashThreshold         Decimal?              @db.Decimal(18, 2)
  expenseIncreaseThreshold Decimal               @default(15) @db.Decimal(5, 2)
  receivablesThreshold     Decimal?              @db.Decimal(18, 2)
  overdueInvoiceDays       Int                   @default(30)
  staleDraftDays           Int                   @default(7)
  // نشاط المنشأة — يُحدَّد عند إنشاء الشركة ويُستخدَم لزرع قالب شجرة الحسابات المطابق تلقائياً
  // (مقاولات/مصانع/تجزئة/تجارة عامة/محطات وقود) بدل القالب الافتراضي العام. اختياري: الشركات
  // القديمة قبل هذه الميزة تبقى null وتُعامَل معاملة "بدون نشاط محدد" (القالب الافتراضي فقط).
  businessActivity         BusinessActivity?
  // --- ربط فاتورة (ZATCA) — المرحلة الثانية (التكامل)، انظر src/lib/zatca/*  ---
  // جهاز إصدار فواتير إلكترونية (EGS) واحد لكل شركة (v1) — CSID واحد، عدّاد ICV واحد،
  // وسلسلة تجزئة (PIH) واحدة تغطي كل الفواتير/الإشعارات الدائنة/المدينة لهذه الشركة معاً.
  zatcaOnboardingStatus    ZatcaOnboardingStatus @default(not_onboarded)
  zatcaEnvironment         ZatcaEnvironment      @default(sandbox)
  zatcaEgsUuid             String?
  zatcaSolutionName        String?
  zatcaModel               String?
  // العدّاد التالي في تسلسل ICV لهذه الشركة — يُزاد ذرّياً فقط لحظة الإرسال الفعلي لزاتكا
  // (Clearance/Reporting)، لا عند مجرد إنشاء مسودة الفاتورة (بنفس أسلوب nextJournalEntrySeq أعلاه).
  zatcaNextIcv             Int                   @default(1)
  // تجزئة (hash) آخر مستند تم إرساله فعلياً لزاتكا — تصبح PIH للمستند التالي في السلسلة.
  zatcaLastInvoiceHash     String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  costCenters          CostCenter[]
  companyDocuments     CompanyDocument[]
  leaseContracts       LeaseContract[]
  journalEntries       JournalEntry[]
  accounts             Account[]
  intercompanyAccounts Account[]               @relation("AccountIntercompanyCompany")
  customers            Customer[]
  quotations           Quotation[]
  salesInvoices        SalesInvoice[]
  salesReturns         SalesReturn[]
  salesDebitNotes      SalesDebitNote[]
  zatcaCredential      CompanyZatcaCredential?
  receipts             Receipt[]
  stationSales         StationSale[]
  suppliers            Supplier[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseReturns      PurchaseReturn[]
  items                Item[]
  warehouses           Warehouse[]
  stockMovements       StockMovement[]
  fixedAssets          FixedAsset[]
  assetCategories      AssetCategory[]
  depreciationRuns     DepreciationRun[]
  employees            Employee[]
  payrollRuns          PayrollRun[]
  attendanceRecords    AttendanceRecord[]
  payrollComponents    PayrollComponent[]
  payrollSettings      PayrollSettings?
  reportSchedule       ReportSchedule?
  employeeAdvances     EmployeeAdvance[]

  @@unique([tenantId, name])
  @@map("companies")
}

// أسرار ربط فاتورة (ZATCA) الخاصة بشركة واحدة — مفتاح خاص/شهادات/أسرار API. كل الحقول المنتهية
// بـ Enc قيم مُشفّرة بالكامل (AES-256-GCM) عبر src/lib/zatca/secretBox.ts قبل الكتابة، ولا تُخزَّن
// أبداً كنص خام. علاقة 1:1 صارمة مع Company (لا مشاركة بين الشركات — كل شركة CSID مستقل تماماً).
model CompanyZatcaCredential {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  privateKeyEnc       String? // مفتاح secp256k1 الخاص (PEM)، مُشفَّر
  csrPem              String? // آخر CSR تم توليده — نص عادي (لا يحتوي سراً، PKCS#10 عام)
  complianceCertEnc   String? // شهادة الاختبار (Compliance CSID)، مُشفَّرة
  complianceSecretEnc String? // سر API المرافق لشهادة الاختبار، مُشفَّر
  complianceRequestId String? // request_id المُستخدَم لاحقاً لاستبداله بشهادة الإنتاج
  productionCertEnc   String? // شهادة الإنتاج (Production CSID)، مُشفَّرة
  productionSecretEnc String? // سر API المرافق لشهادة الإنتاج، مُشفَّر
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("company_zatca_credentials")
}

// مركز تكلفة/موقع/فرع/مخزن — قد يكون عاماً (companyId فارغ) أو خاصاً بشركة معينة
model CostCenter {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalEntryLines JournalEntryLine[]
  stationSales      StationSale[]
  fixedAssets       FixedAsset[]

  @@map("cost_centers")
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum VatFilingFrequency {
  monthly
  quarterly
}

// نشاط المنشأة الرئيسي — يحدد أي قالب شجرة حسابات (chartTemplates.ts) يُزرَع تلقائياً عند الإنشاء
enum BusinessActivity {
  contracting
  manufacturing
  retail
  general_trade
  fuel_stations
}

// حالة استخراج شهادة ربط فاتورة (ZATCA CSID) لهذه الشركة تحديداً
enum ZatcaOnboardingStatus {
  not_onboarded // لم يبدأ الربط بعد
  compliance // تم استخراج شهادة الاختبار (Compliance CSID) فقط
  production // تم استخراج شهادة الإنتاج (Production CSID) — جاهزة للتشغيل الفعلي
}

// البيئة الحالية التي تُرسَل إليها فواتير هذه الشركة فعلياً
enum ZatcaEnvironment {
  sandbox // بوابة المطورين العامة (بيانات/شهادات وهمية للاختبار فقط)
  simulation // محاكاة بحساب الشركة الحقيقي (OTP حقيقي) لكن غير ملزمة قانونياً
  production // البيئة الفعلية الملزمة قانونياً
}

// حالة مستند فوترة إلكترونية واحد أمام زاتكا (فاتورة/إشعار دائن/إشعار مدين)
enum ZatcaDocumentStatus {
  not_applicable // الشركة لم تُفعّل الربط مع زاتكا بعد لهذا المستند
  pending_clearance // فاتورة قياسية (B2B) بانتظار رد التخليص (Clearance) قبل تسليمها للعميل
  cleared // تم تخليصها من زاتكا بنجاح
  pending_reporting // فاتورة مبسّطة (B2C) سُلّمت للعميل وبانتظار الإبلاغ عنها خلال 24 ساعة
  reported // تم الإبلاغ عنها لزاتكا بنجاح
  rejected // رفضتها زاتكا — تبقى المسودة غير مرحّلة نهائياً حتى تصحيحها وإعادة الإرسال
}

// تصنيف الضريبة على مستوى السطر وفق قائمة أكواد زاتكا/UBL القياسية
enum TaxCategoryCode {
  S // خاضع للنسبة الأساسية (Standard-rated)
  Z // خاضع بنسبة صفر (Zero-rated)
  E // معفى (Exempt) — يتطلب سبب إعفاء
  O // خارج نطاق ضريبة القيمة المضافة (Out of scope)
}

// شجرة الحسابات
model Account {
  id                       String      @id @default(cuid())
  tenantId                 String
  tenant                   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId                String?
  company                  Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentId                 String?
  parent                   Account?    @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                 Account[]   @relation("AccountHierarchy")
  code                     String
  level                    Int
  isPosting                Boolean     @default(false)
  isArchived               Boolean     @default(false)
  name                     String
  nameEn                   String?
  type                     AccountType
  isActive                 Boolean     @default(true)
  // يُحدَّد يدوياً عند إنشاء/تعديل الحساب — يُستخدَم لتحديد أي حسابات "أصول" تمثّل
  // نقدية فعلية (صندوق/بنوك) لعرضها في رسم توزيع الكاش بالداشبورد ولاختيار الحساب
  // البنكي عند تحصيل سند قبض بنكي، بدل التخمين من اسم الحساب
  isBankOrCash             Boolean     @default(false)
  // يُحدَّد يدوياً — يُستخدَم لتفعيل نافذة "أصل جديد/أصل موجود" عند اختيار هذا الحساب في سطر أي
  // قيد يومية أو فاتورة مشتريات (بدل الاعتماد على موقعه في الشجرة، هش أمام إعادة الترتيب/القوالب
  // المختلفة). يُفعَّل فقط على حسابات اقتناء الأصول (مثل "أراضٍ"، "آلات ومعدات")، وليس على حساب
  // "مجمع الإهلاك" العكسي.
  isFixedAssetAccount      Boolean     @default(false)
  // يُحدَّد يدوياً (بلا نظام فئات مقابل — كل سلفة تختار حسابها مباشرة عند الإنشاء) — يُستخدَم
  // لتفعيل نافذة "سلفة جديدة/سلفة موجودة" عند اختيار هذا الحساب في سطر قيد يومية (Phase F).
  isEmployeeAdvanceAccount Boolean     @default(false)
  // يُملأ تلقائياً فقط عند إنشاء "حساب ربط بيني" يمثّل شركة شقيقة أخرى ضمن نفس المستأجر (ميزة
  // قيد المرآة بين الشركات) — يُحدِّد الحساب الذي يُسجَّل عليه أي مبلغ مستحق من/إلى تلك الشركة
  // تحديداً، بدل الاعتماد على مطابقة اسم الحساب نصياً (هش عند إعادة تسمية الشركة لاحقاً).
  // حساب واحد لكل شركة مستهدفة داخل شجرة كل شركة مالكة للحساب.
  intercompanyCompanyId    String?
  intercompanyCompany      Company?    @relation("AccountIntercompanyCompany", fields: [intercompanyCompanyId], references: [id], onDelete: SetNull)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  journalEntryLines            JournalEntryLine[]
  salesInvoiceLines            SalesInvoiceLine[]
  salesReturnLines             SalesReturnLine[]
  salesDebitNoteLines          SalesDebitNoteLine[]
  purchaseInvoiceLines         PurchaseInvoiceLine[]
  purchaseReturnLines          PurchaseReturnLine[]
  receiptsAsBank               Receipt[]             @relation("ReceiptBankAccount")
  itemStockLinks               Item[]                @relation("ItemStockAccount")
  itemCogsLinks                Item[]                @relation("ItemCogsAccount")
  itemRevenueLinks             Item[]                @relation("ItemRevenueAccount")
  itemExpenseLinks             Item[]                @relation("ItemExpenseAccount")
  customerLinks                Customer[]
  supplierLinks                Supplier[]
  employeeLinks                Employee[]
  payrollComponentLinks        PayrollComponent[]
  fixedAssetLinks              FixedAsset[]
  employeeAdvanceLinks         EmployeeAdvance[]
  assetCategoryAssetLinks      AssetCategory[]       @relation("AssetCategoryAssetAccount")
  assetCategoryAccDepLinks     AssetCategory[]       @relation("AssetCategoryAccumulatedDepreciationAccount")
  assetCategoryDepExpenseLinks AssetCategory[]       @relation("AssetCategoryDepreciationExpenseAccount")

  @@unique([tenantId, companyId, code])
  @@unique([tenantId, companyId, intercompanyCompanyId])
  @@index([tenantId, companyId, parentId])
  @@map("accounts")
}

// مستندات رسمية للشركة: سجل تجاري، دفاع مدني... إلخ
model CompanyDocument {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docType    String
  number     String?
  locationId String?
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("company_documents")
}

// عقود إيجار الشركة (مقرات/فروع/مستودعات) — لتنبيه اقتراب انتهاء العقد بالداشبورد المالية
model LeaseContract {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  counterparty String?
  monthlyRent  Decimal? @db.Decimal(18, 2)
  startDate    DateTime
  endDate      DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("lease_contracts")
}

// ---------------------------------------------------------------------------
// 4.3 القيود اليومية — جوهر النظام (القيد المزدوج كمصدر حقيقة واحد)
// ---------------------------------------------------------------------------

// خاصة بـ PayrollRun فقط (دورة حياة تشغيل الرواتب نفسها، منفصلة عن حالة القيد المحاسبي)
enum JournalStatus {
  draft
  posted
}

// حالة القيد المحاسبي نفسه: لا يوجد "مسودة" — "محفوظ" (قابل للتعديل، ويؤثر على الأرصدة والتقارير
// فوراً) أو "مرحّل" (نهائي، مقفل تماماً، يُصحَّح فقط عبر عكس القيد). enum منفصل عمداً عن
// JournalStatus أعلاه (رغم تطابق الاسمين ظاهرياً) لتفادي أي أثر جانبي على دورة حياة تشغيل الرواتب
// التي لم يطلب تعديلها.
enum JournalEntryStatus {
  saved
  posted
}

enum SourceModule {
  manual
  sales_invoice
  sales_return
  sales_debit_note
  receipt
  purchase_invoice
  purchase_return
  payroll
  depreciation
  asset_disposal
  leave_settlement
  stock_movement
  ai_document
  bulk_import
}

model JournalEntry {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date              DateTime
  memo              String?
  status            JournalEntryStatus @default(posted)
  // رقم القيد التسلسلي بصيغة [بادئة الشركة][5 خانات] (مثال J00001).
  entryNumber       String
  sourceModule      SourceModule       @default(manual)
  sourceId          String?
  // مرجع منطقي حر (بلا علاقة FK صارمة) لقيد "المرآة" المقابل في شركة أخرى ضمن نفس المستأجر —
  // يُملأ تبادلياً على القيدين معاً عند إنشاء قيد مرآة (كل قيد يشير لمعرّف الآخر)، بنفس أسلوب
  // sourceId أعلاه، بدل علاقة self-relation ذاتية قد تعقّد القراءة/الكتابة من الجهتين بلا داعٍ.
  mirrorEntryId     String?
  // مرجع منطقي حر (يُملأ فقط على القيد العكسي الجديد، لا على القيد الأصلي) لقيد "العكس" —
  // اتجاه واحد فقط لتفادي معاملة تُحدِّث صفّين معاً كما في mirrorEntryId؛ لمعرفة هل قيد ما
  // تم عكسه لاحقاً، يُبحث عن قيد آخر بنفس tenantId حيث reversalOfEntryId يساوي معرّف هذا القيد.
  reversalOfEntryId String?
  createdBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  lines JournalEntryLine[]

  @@unique([companyId, entryNumber])
  @@index([tenantId, companyId, date])
  @@index([tenantId, sourceModule, sourceId])
  @@index([tenantId, mirrorEntryId])
  @@index([tenantId, reversalOfEntryId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id                String           @id @default(cuid())
  journalEntryId    String
  journalEntry      JournalEntry     @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account          @relation(fields: [accountId], references: [id])
  costCenterId      String?
  costCenter        CostCenter?      @relation(fields: [costCenterId], references: [id])
  department        String?
  // وصف خاص بهذا السطر تحديداً (مختلف عن JournalEntry.memo العام) — يظهر في كشف حساب الأستاذ
  // بجانب البيان العام، لتوضيح تفاصيل كل حركة على حساب معيّن دون الرجوع للقيد الكامل.
  description       String?
  debit             Decimal          @default(0) @db.Decimal(18, 2)
  credit            Decimal          @default(0) @db.Decimal(18, 2)
  customerId        String?
  customer          Customer?        @relation(fields: [customerId], references: [id])
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  employeeId        String?
  employee          Employee?        @relation(fields: [employeeId], references: [id])
  // يُملأ فقط لو تم اختيار حساب أصول ثابتة على هذا السطر تحديداً وتم ربطه بأصل (جديد أو موجود) —
  // انظر FixedAsset.isFixedAssetAccount وتدفّق النافذة المنبثقة في JournalEntryFormModal.
  fixedAssetId      String?
  fixedAsset        FixedAsset?      @relation(fields: [fixedAssetId], references: [id], onDelete: SetNull)
  // يُملأ فقط لو تم اختيار حساب عهدة/سلفة موظف على هذا السطر تحديداً وتم ربطه بسلفة (جديدة أو
  // موجودة).
  employeeAdvanceId String?
  employeeAdvance   EmployeeAdvance? @relation(fields: [employeeAdvanceId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([customerId])
  @@index([supplierId])
  @@index([employeeId])
  @@index([fixedAssetId])
  @@index([employeeAdvanceId])
  @@map("journal_entry_lines")
}

// ---------------------------------------------------------------------------
// 4.4 المبيعات (نماذج البيانات موثّقة الآن؛ الـ API يُبنى في المرحلة الأولى)
// ---------------------------------------------------------------------------

enum CustomerType {
  business
  individual
}

model Customer {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  customerType CustomerType @default(business)
  vatNumber    String?
  crNumber     String?
  nationalId   String?
  phone        String?
  email        String?
  buildingNo   String?
  street       String?
  district     String?
  city         String?
  postalCode   String?
  additionalNo String?
  paymentTerms String?
  creditLimit  Decimal?     @db.Decimal(18, 2)
  // حساب تفصيلي مستقل (مستوى رابع) تحت "الذمم المدينة التجارية" — يُنشأ تلقائياً عند إنشاء العميل
  // ويُزامَن اسمه مع اسم العميل عند التعديل (partyAccounts.ts). Nullable مؤقتاً حتى تكتمل التعبئة
  // الرجعية للعملاء القدامى، ثم يصبح إلزامياً.
  accountId    String?
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  quotations        Quotation[]
  salesInvoices     SalesInvoice[]
  salesReturns      SalesReturn[]
  salesDebitNotes   SalesDebitNote[]
  receipts          Receipt[]
  journalEntryLines JournalEntryLine[]

  @@map("customers")
}

enum QuotationStatus {
  draft
  converted
}

model Quotation {
  id                 String          @id @default(cuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quoteNumber        String
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id])
  date               DateTime
  validUntil         DateTime?
  status             QuotationStatus @default(draft)
  convertedInvoiceId String?
  lines              Json
  subtotal           Decimal         @db.Decimal(18, 2)
  vatTotal           Decimal         @db.Decimal(18, 2)
  grandTotal         Decimal         @db.Decimal(18, 2)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([tenantId, quoteNumber])
  @@map("quotations")
}

enum InvoiceType {
  standard
  simplified
}

enum InvoiceStatus {
  draft
  posted
}

model SalesInvoice {
  id                       String              @id @default(cuid())
  tenantId                 String
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNumber            String
  companyId                String
  company                  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId               String
  customer                 Customer            @relation(fields: [customerId], references: [id])
  date                     DateTime
  invoiceType              InvoiceType
  status                   InvoiceStatus       @default(posted)
  journalEntryId           String?
  qrPayload                String?
  subtotal                 Decimal             @db.Decimal(18, 2)
  vatTotal                 Decimal             @db.Decimal(18, 2)
  grandTotal               Decimal             @db.Decimal(18, 2)
  // --- ربط فاتورة (ZATCA) — المرحلة الثانية، انظر src/lib/zatca/* ---
  // معرّف عالمي فريد (UUID v4) خاص بالفاتورة، مستقل عن invoiceNumber التسلسلي القابل للقراءة.
  zatcaUuid                String              @unique @default(uuid())
  // رقم العدّاد (Invoice Counter Value) — يُحجز ذرّياً من Company.zatcaNextIcv فقط لحظة
  // الإرسال الفعلي لزاتكا (Clearance/Reporting)، لا عند إنشاء المسودة. null = لم تُرسَل بعد.
  icv                      Int?
  // تجزئة المستند السابق في سلسلة الشركة (PIH) وتجزئة هذا المستند نفسه (تصبح PIH التالي).
  previousInvoiceHash      String?
  invoiceHash              String?
  xmlAttachmentId          String?
  pdfAttachmentId          String?
  zatcaStatus              ZatcaDocumentStatus @default(not_applicable)
  zatcaResponseRaw         Json?
  zatcaSubmittedAt         DateTime?
  zatcaClearedOrReportedAt DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  lines              SalesInvoiceLine[]
  receiptAllocations ReceiptAllocation[]
  emailLogs          InvoiceEmailLog[]

  @@unique([tenantId, invoiceNumber])
  @@map("sales_invoices")
}

// سجل كل محاولة إرسال فاتورة بالإيميل (تلقائية عند الترحيل، أو يدوية من زر "إرسال بالإيميل")
// — يُبنى منه عرض "آخر إرسال: [تاريخ ووقت]" في شاشة الفاتورة، ويحتفظ بسبب الفشل إن وُجد.
model InvoiceEmailLog {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentTo    String
  method    String // "auto" | "manual"
  success   Boolean
  error     String?
  createdAt DateTime     @default(now())

  @@map("invoice_email_logs")
}

model SalesInvoiceLine {
  id                 String          @id @default(cuid())
  invoiceId          String
  invoice            SalesInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  accountId          String
  account            Account         @relation(fields: [accountId], references: [id])
  itemId             String?
  item               Item?           @relation(fields: [itemId], references: [id])
  description        String?
  quantity           Decimal         @db.Decimal(18, 4)
  unitPrice          Decimal         @db.Decimal(18, 4)
  discountPct        Decimal         @default(0) @db.Decimal(5, 2)
  priceIncludesVat   Boolean         @default(false)
  vatApplicable      Boolean         @default(true)
  // تصنيف الضريبة القياسي لزاتكا (UBL cac:ClassifiedTaxCategory) — يُشتق افتراضياً من
  // vatApplicable أعلاه (true => S، false => O) عند عدم تحديده صراحةً.
  taxCategoryCode    TaxCategoryCode @default(S)
  taxExemptionReason String?
  subtotal           Decimal         @db.Decimal(18, 2)
  vat                Decimal         @db.Decimal(18, 2)
  total              Decimal         @db.Decimal(18, 2)

  @@map("sales_invoice_lines")
}

model SalesReturn {
  id                       String              @id @default(cuid())
  tenantId                 String
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  returnNumber             String
  companyId                String
  company                  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId               String
  customer                 Customer            @relation(fields: [customerId], references: [id])
  relatedInvoiceId         String?
  reason                   String?
  refundMethod             String?
  date                     DateTime
  status                   InvoiceStatus       @default(posted)
  journalEntryId           String?
  subtotal                 Decimal             @db.Decimal(18, 2)
  vatTotal                 Decimal             @db.Decimal(18, 2)
  grandTotal               Decimal             @db.Decimal(18, 2)
  // --- ربط فاتورة (ZATCA) — إشعار دائن (Credit Note، كود UBL 381)، نفس حقول SalesInvoice ---
  zatcaUuid                String              @unique @default(uuid())
  icv                      Int?
  previousInvoiceHash      String?
  invoiceHash              String?
  xmlAttachmentId          String?
  pdfAttachmentId          String?
  zatcaStatus              ZatcaDocumentStatus @default(not_applicable)
  zatcaResponseRaw         Json?
  zatcaSubmittedAt         DateTime?
  zatcaClearedOrReportedAt DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  lines SalesReturnLine[]

  @@unique([tenantId, returnNumber])
  @@map("sales_returns")
}

model SalesReturnLine {
  id                 String          @id @default(cuid())
  returnId           String
  salesReturn        SalesReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  accountId          String
  account            Account         @relation(fields: [accountId], references: [id])
  description        String?
  quantity           Decimal         @db.Decimal(18, 4)
  unitPrice          Decimal         @db.Decimal(18, 4)
  discountPct        Decimal         @default(0) @db.Decimal(5, 2)
  priceIncludesVat   Boolean         @default(false)
  taxCategoryCode    TaxCategoryCode @default(S)
  taxExemptionReason String?
  subtotal           Decimal         @db.Decimal(18, 2)
  vat                Decimal         @db.Decimal(18, 2)
  total              Decimal         @db.Decimal(18, 2)

  @@map("sales_return_lines")
}

// إشعار مدين (Debit Note، كود UBL 383) — رسوم إضافية على فاتورة سابقة (عكس المردود تماماً)،
// يزيد ما يستحق على العميل بدل تخفيضه. يُبنى بنفس بنية SalesReturn/SalesReturnLine حرفياً.
model SalesDebitNote {
  id                       String              @id @default(cuid())
  tenantId                 String
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  debitNoteNumber          String
  companyId                String
  company                  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId               String
  customer                 Customer            @relation(fields: [customerId], references: [id])
  relatedInvoiceId         String?
  reason                   String?
  // كيفية تحصيل المبلغ الإضافي: يُضاف لذمم العميل، أو يُحصَّل نقداً/بنكياً فوراً (بنفس معنى
  // refundMethod في SalesReturn لكن بالاتجاه المعاكس).
  chargeMethod             String?
  date                     DateTime
  status                   InvoiceStatus       @default(posted)
  journalEntryId           String?
  subtotal                 Decimal             @db.Decimal(18, 2)
  vatTotal                 Decimal             @db.Decimal(18, 2)
  grandTotal               Decimal             @db.Decimal(18, 2)
  // --- ربط فاتورة (ZATCA) — نفس حقول SalesInvoice/SalesReturn ---
  zatcaUuid                String              @unique @default(uuid())
  icv                      Int?
  previousInvoiceHash      String?
  invoiceHash              String?
  xmlAttachmentId          String?
  pdfAttachmentId          String?
  zatcaStatus              ZatcaDocumentStatus @default(not_applicable)
  zatcaResponseRaw         Json?
  zatcaSubmittedAt         DateTime?
  zatcaClearedOrReportedAt DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  lines SalesDebitNoteLine[]

  @@unique([tenantId, debitNoteNumber])
  @@map("sales_debit_notes")
}

model SalesDebitNoteLine {
  id                 String          @id @default(cuid())
  debitNoteId        String
  salesDebitNote     SalesDebitNote  @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  accountId          String
  account            Account         @relation(fields: [accountId], references: [id])
  description        String?
  quantity           Decimal         @db.Decimal(18, 4)
  unitPrice          Decimal         @db.Decimal(18, 4)
  discountPct        Decimal         @default(0) @db.Decimal(5, 2)
  priceIncludesVat   Boolean         @default(false)
  taxCategoryCode    TaxCategoryCode @default(S)
  taxExemptionReason String?
  subtotal           Decimal         @db.Decimal(18, 2)
  vat                Decimal         @db.Decimal(18, 2)
  total              Decimal         @db.Decimal(18, 2)

  @@map("sales_debit_note_lines")
}

enum ReceiptMethod {
  cash
  bank
}

model Receipt {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receiptNumber  String
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  date           DateTime
  method         ReceiptMethod
  // الحساب البنكي المحدَّد الذي استُلم فيه المبلغ فعلياً (عند method=bank فقط) — إن تُرك
  // فارغاً يُستخدَم الحساب البنكي الافتراضي القديم للتوافق مع السندات المُنشأة قبل هذا الحقل
  bankAccountId  String?
  bankAccount    Account?      @relation("ReceiptBankAccount", fields: [bankAccountId], references: [id])
  totalAmount    Decimal       @db.Decimal(18, 2)
  status         InvoiceStatus @default(posted)
  journalEntryId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  allocations ReceiptAllocation[]

  @@unique([tenantId, receiptNumber])
  @@map("receipts")
}

model ReceiptAllocation {
  id        String       @id @default(cuid())
  receiptId String
  receipt   Receipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id])
  amount    Decimal      @db.Decimal(18, 2)

  @@map("receipt_allocations")
}

// مبيعات المحطات — سجل تشغيلي بحت (لا يُنشئ قيداً محاسبياً)، يُستخدم لمتابعة كميات
// وأسعار الوقود المباعة لكل محطة. "المحطة" هنا هي مركز تكلفة (CostCenter) موجود أصلاً،
// وليست كياناً منفصلاً، تماشياً مع نموذج مراكز التكلفة الموثّق في القسم 4.2.
model StationSale {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenterId  String
  costCenter    CostCenter @relation(fields: [costCenterId], references: [id])
  date          DateTime
  liters        Decimal    @db.Decimal(18, 3)
  pricePerLiter Decimal    @db.Decimal(18, 4)
  shiftNote     String?
  createdAt     DateTime   @default(now())

  @@map("station_sales")
}

// ---------------------------------------------------------------------------
// 4.5 المشتريات (نفس بنية المبيعات، بدون QR وبدون تصنيف قياسية/مبسّطة)
// ---------------------------------------------------------------------------

model Supplier {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  vatNumber    String?
  crNumber     String?
  phone        String?
  email        String?
  city         String?
  paymentTerms String?
  // حساب تفصيلي مستقل (مستوى رابع) تحت "الذمم الدائنة التجارية" — نفس مبدأ Customer.accountId.
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseInvoices  PurchaseInvoice[]
  purchaseReturns   PurchaseReturn[]
  journalEntryLines JournalEntryLine[]

  @@map("suppliers")
}

model PurchaseInvoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  date           DateTime
  status         InvoiceStatus @default(posted)
  journalEntryId String?
  subtotal       Decimal       @db.Decimal(18, 2)
  vatTotal       Decimal       @db.Decimal(18, 2)
  grandTotal     Decimal       @db.Decimal(18, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines PurchaseInvoiceLine[]

  @@unique([tenantId, invoiceNumber])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id               String          @id @default(cuid())
  invoiceId        String
  invoice          PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // حساب يدوي — يبقى إلزامياً دايماً كـ fallback؛ لو السطر مرتبط بصنف (itemId) يُشتق الحساب
  // تلقائياً من نوع الصنف عند الترحيل (مش من هذا الحقل)، وأي قيمة يرسلها العميل هنا تُتجاهل.
  accountId        String
  account          Account         @relation(fields: [accountId], references: [id])
  itemId           String?
  item             Item?           @relation(fields: [itemId], references: [id])
  warehouseId      String?
  warehouse        Warehouse?      @relation(fields: [warehouseId], references: [id])
  // فقط لو item.type == fixed_asset — تُستخدَم لإنشاء سجل الأصل الثابت المرتبط بهذا السطر
  usefulLifeYears  Int?
  salvageValue     Decimal?        @db.Decimal(18, 2)
  description      String?
  quantity         Decimal         @db.Decimal(18, 4)
  unitPrice        Decimal         @db.Decimal(18, 4)
  discountPct      Decimal         @default(0) @db.Decimal(5, 2)
  priceIncludesVat Boolean         @default(false)
  subtotal         Decimal         @db.Decimal(18, 2)
  vat              Decimal         @db.Decimal(18, 2)
  total            Decimal         @db.Decimal(18, 2)

  @@map("purchase_invoice_lines")
}

model PurchaseReturn {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  returnNumber     String
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier      @relation(fields: [supplierId], references: [id])
  relatedInvoiceId String?
  reason           String?
  date             DateTime
  status           InvoiceStatus @default(posted)
  journalEntryId   String?
  subtotal         Decimal       @db.Decimal(18, 2)
  vatTotal         Decimal       @db.Decimal(18, 2)
  grandTotal       Decimal       @db.Decimal(18, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lines PurchaseReturnLine[]

  @@unique([tenantId, returnNumber])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id               String         @id @default(cuid())
  returnId         String
  purchaseReturn   PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account        @relation(fields: [accountId], references: [id])
  description      String?
  quantity         Decimal        @db.Decimal(18, 4)
  unitPrice        Decimal        @db.Decimal(18, 4)
  discountPct      Decimal        @default(0) @db.Decimal(5, 2)
  priceIncludesVat Boolean        @default(false)
  subtotal         Decimal        @db.Decimal(18, 2)
  vat              Decimal        @db.Decimal(18, 2)
  total            Decimal        @db.Decimal(18, 2)

  @@map("purchase_return_lines")
}

// ---------------------------------------------------------------------------
// 4.6 المستودعات والمنتجات
// ---------------------------------------------------------------------------

// نوع الصنف — يحدد سلوكه المحاسبي تلقائياً عند الشراء والبيع (انظر items.service.ts
// لمنطق التحقق من الحسابات المطلوبة لكل نوع).
enum ItemType {
  inventory // مخزوني — الافتراضي، نفس سلوك Item القديم بالضبط
  expense // مصروف/غير مخزوني — يُشترى ويُستهلك داخلياً، لا بيع له
  service // خدمي — بدون تتبع كمية أو مخزون إطلاقاً
  fixed_asset // أصل ثابت — يُنشئ سجل أصل ثابت تلقائياً عند الشراء
  raw_material // مادة أولية — تُستهلك كمكوّن في منتج مجمّع، لا تُباع مباشرة إلا لو allowDirectSale
  bundle // منتج مجمّع — رصيده يزيد فقط عبر أمر تصنيع (مرحلة قادمة)، لا يُشترى مباشرة
}

// كتالوج الأصناف الموحّد — يحل محل Item (مخزون) و SellableItem (مبيعات) القديمين معاً.
// الربط المحاسبي يُحدَّد هنا فقط، لا يظهر اختيار حساب يدوي داخل سطر الفاتورة لأي صنف.
model Item {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code       String
  name       String
  // باركود اختياري لمسحه ضوئياً في نقطة البيع (POS) — فريد لكل شركة لو محدَّد، بلا قيد على الشركات
  // الأخرى (نفس الباركود قد يتكرر بين شركات مختلفة لنفس المنتج التجاري).
  barcode    String?
  type       ItemType @default(inventory)
  unit       String?
  category   String?
  isArchived Boolean  @default(false)

  // التسعير/التكلفة
  costPrice         Decimal  @default(0) @db.Decimal(18, 4) // القيمة اليدوية القديمة قبل هذا التحديث — أثر تاريخي فقط، لا يُستخدَم في أي منطق جديد
  averageCost       Decimal  @default(0) @db.Decimal(18, 4) // متوسط التكلفة المرجّح اللحظي — يُحدَّثه costingEngine.ts تلقائياً فقط، غير قابل للتعديل اليدوي
  lastPurchasePrice Decimal? @db.Decimal(18, 4)
  salePrice         Decimal? @db.Decimal(18, 4) // سعر بيع مقترح افتراضي (كان SellableItem.defaultUnitPrice)
  vatApplicable     Boolean  @default(true)
  reorderLevel      Decimal? @db.Decimal(18, 2)

  // الربط المحاسبي — حسب النوع (انظر التحقق الديناميكي في items.schemas.ts)
  stockAccountId   String?
  stockAccount     Account? @relation("ItemStockAccount", fields: [stockAccountId], references: [id])
  cogsAccountId    String?
  cogsAccount      Account? @relation("ItemCogsAccount", fields: [cogsAccountId], references: [id])
  revenueAccountId String?
  revenueAccount   Account? @relation("ItemRevenueAccount", fields: [revenueAccountId], references: [id])
  expenseAccountId String?
  expenseAccount   Account? @relation("ItemExpenseAccount", fields: [expenseAccountId], references: [id])

  // type == raw_material فقط
  allowDirectSale Boolean @default(false)

  // type == fixed_asset فقط — فئة الأصل (نفس AssetCategory المستخدَمة في تسجيل الأصول اليدوي)
  // تُشتَق منها حسابات الاقتناء/مجمع الإهلاك/مصروف الإهلاك تلقائياً عند شراء الصنف (Phase G) —
  // بدل حساب "الأصول الثابتة" المشترك الثابت الذي كان يُستخدَم سابقاً بلا تصنيف.
  assetCategoryId  String?
  assetCategoryRef AssetCategory? @relation("ItemAssetCategory", fields: [assetCategoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements       StockMovement[]
  salesInvoiceLines    SalesInvoiceLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  bomLines             ItemComponent[]       @relation("BundleParent")
  usedInBundles        ItemComponent[]       @relation("ComponentItem")

  @@unique([tenantId, companyId, code])
  @@unique([tenantId, companyId, barcode])
  @@index([tenantId, companyId, type])
  @@map("items")
}

// قائمة مكوّنات "منتج مجمّع" (Bill of Materials مبسّط) — بيانات فقط في هذه المرحلة،
// الاستهلاك الفعلي عبر "أمر تصنيع" في مرحلة قادمة منفصلة.
model ItemComponent {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentItemId    String
  parentItem      Item     @relation("BundleParent", fields: [parentItemId], references: [id], onDelete: Cascade)
  componentItemId String
  componentItem   Item     @relation("ComponentItem", fields: [componentItemId], references: [id])
  quantityPerUnit Decimal  @db.Decimal(18, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([parentItemId, componentItemId])
  @@map("item_components")
}

// مستودع حقيقي (منفصل عن CostCenter، كان المخزن قديماً مجرد مركز تكلفة معاد استخدامه)
model Warehouse {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  code       String?
  location   String?
  // المستودع الافتراضي لكل شركة — يُستخدَم لخصم المخزون تلقائياً عند البيع (فاتورة المبيعات
  // لا تعرض اختيار مستودع لكل سطر في هذه المرحلة). شركة واحدة بحد أقصى مستودع افتراضي واحد،
  // يُفرَض هذا في warehouses.service عند الإنشاء/التعديل (مش قيد DB صريح).
  isDefault  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stockMovements       StockMovement[]
  purchaseInvoiceLines PurchaseInvoiceLine[]

  @@unique([tenantId, companyId, name])
  @@map("warehouses")
}

enum StockMovementType {
  in
  out
  issue
  transfer_out
  transfer_in
}

model StockMovement {
  id                          String            @id @default(cuid())
  tenantId                    String
  tenant                      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId                   String
  company                     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemId                      String
  item                        Item              @relation(fields: [itemId], references: [id])
  warehouseId                 String
  warehouse                   Warehouse         @relation(fields: [warehouseId], references: [id])
  type                        StockMovementType
  quantity                    Decimal           @db.Decimal(18, 4)
  unitCost                    Decimal           @db.Decimal(18, 4)
  date                        DateTime
  note                        String?
  journalEntryId              String?
  transferGroupId             String? // يربط سطري (صادر/وارد) نفس عملية التحويل بين شركتين، لحذفهما معاً عند فك الترحيل
  // تتبّع مصدر الحركة عند إنشائها تلقائياً من فاتورة (لحذفها معاً عند فك ترحيل الفاتورة)
  sourcePurchaseInvoiceLineId String?           @unique
  sourceSalesInvoiceLineId    String?           @unique
  createdAt                   DateTime          @default(now())

  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// 4.7 الأصول الثابتة
// ---------------------------------------------------------------------------

enum FixedAssetStatus {
  active
  disposed
}

// طريقة القسط الثابت هي الوحيدة المحسوبة فعلياً حالياً (src/lib/depreciation.ts) — المتناقص
// مُضاف كخيار تخزين/عرض تمهيداً لدعمه لاحقاً، وليس محسوباً بعد؛ الاختيار غير المدعوم يُرفَض في
// طبقة الـ schema بالباك إند (Phase B) لا هنا.
enum FixedAssetDepreciationMethod {
  straight_line
  declining_balance
}

// تصنيف أصول (Phase C) — "المجموعة" (groupName) وصف عرض/تجميع فقط بلا حسابات خاصة به،
// بينما "الفئة" (name) هي المستوى الذي يحمل الربط الفعلي بثلاثة حسابات محاسبية. اختيار فئة عند
// تسجيل أصل جديد يملأ حسابه تلقائياً بدل اختيار حساب خام يدوياً في كل مرة، ويُفعِّل
// isFixedAssetAccount تلقائياً على حساب الأصل المرتبط. لا مستوى "قسم" مستقل هنا — CostCenter
// الموجود بالفعل على FixedAsset.costCenterId يغطي هذا المفهوم.
model AssetCategory {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groupName String
  name      String

  assetAccountId String
  assetAccount   Account @relation("AssetCategoryAssetAccount", fields: [assetAccountId], references: [id], onDelete: Restrict)

  accumulatedDepreciationAccountId String
  accumulatedDepreciationAccount   Account @relation("AssetCategoryAccumulatedDepreciationAccount", fields: [accumulatedDepreciationAccountId], references: [id], onDelete: Restrict)

  depreciationExpenseAccountId String
  depreciationExpenseAccount   Account @relation("AssetCategoryDepreciationExpenseAccount", fields: [depreciationExpenseAccountId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets FixedAsset[]
  items  Item[]       @relation("ItemAssetCategory")

  @@unique([tenantId, companyId, name])
  @@map("asset_categories")
}

model FixedAsset {
  id                          String                       @id @default(cuid())
  tenantId                    String
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId                   String
  company                     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // رقم تسلسلي تلقائي بصيغة AST-00001 (نفس نمط formatDocNumber المستخدَم لباقي أرقام
  // المستندات) — يُولَّد في الباك إند وقت الإنشاء (Phase B)، وليس هنا.
  assetNumber                 String
  name                        String
  category                    String?
  // فئة الأصل (Phase C) — عند تحديدها، تُشتق منها الحسابات الثلاثة تلقائياً بدل اختيار accountId
  // يدوياً؛ nullable لبقاء التوافق مع أصول قديمة/بلا تصنيف (تسقط على المسار الاحتياطي القديم).
  categoryId                  String?
  categoryRef                 AssetCategory?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  serialNumber                String?
  // يظهر فقط في الواجهة لو category يوحي بمركبة — مُخزَّن دائماً بلا قيد على نوع الأصل هنا.
  chassisNumber               String?
  plateNumber                 String?
  // الموقع/الفرع — يعيد استخدام CostCenter الموجود بالفعل (نفس مفهوم "الموقع" المستخدَم في
  // القيود ومبيعات المحطات) بدل نموذج مستقل جديد لمفهوم مطابق.
  costCenterId                String?
  costCenter                  CostCenter?                  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  // من يحمل هذا الأصل كعهدة حالياً — تتبّع حالة بسيط بلا أي أثر محاسبي، منفصل تماماً عن
  // EmployeeAdvance المالي. أي نوع أصل (لا يقتصر على مركبات). تاريخ العهدة عبر الزمن مؤجَّل.
  custodianEmployeeId         String?
  custodian                   Employee?                    @relation("FixedAssetCustodian", fields: [custodianEmployeeId], references: [id], onDelete: SetNull)
  purchaseDate                DateTime
  cost                        Decimal                      @db.Decimal(18, 2)
  // تاريخ بدء حساب الإهلاك — قد يختلف عن تاريخ الشراء (مثلاً أصل اشتُري ولم يُشغَّل فوراً).
  // Nullable لتوافق الأصول القديمة؛ يُستخدَم purchaseDate كاحتياطي عند غيابه.
  depreciationStartDate       DateTime?
  usefulLifeYears             Decimal                      @db.Decimal(6, 2)
  salvageValue                Decimal                      @default(0) @db.Decimal(18, 2)
  depreciationMethod          FixedAssetDepreciationMethod @default(straight_line)
  // false لأصول لا تُستهلك (مثل الأراضي) — تُستبعَد من حساب الإهلاك الشهري بالكامل.
  isDepreciable               Boolean                      @default(true)
  status                      FixedAssetStatus             @default(active)
  disposalDate                DateTime?
  disposalValue               Decimal?                     @db.Decimal(18, 2)
  // الحساب الفعلي الذي رُحِّلت عليه تكلفة اقتناء هذا الأصل تحديداً (بدل حساب مشترك واحد لكل
  // الأصول) — يُستخدَم لترحيل الإهلاك الشهري والاستبعاد على نفس الحساب تحديداً (Phase B).
  // Nullable احترازياً فقط (لا توجد بيانات قديمة بلا حساب فعلياً وقت هذا التعديل) — أي أصل
  // مستقبلي بلا accountId يقع على المسار الاحتياطي القديم (بحث بالاسم) بدل فشل صريح.
  accountId                   String?
  account                     Account?                     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  journalEntryId              String?
  // لو الأصل اتسجّل تلقائياً من سطر فاتورة مشتريات (صنف من نوع "أصل ثابت")، بيربط بنفس
  // قيد الفاتورة (journalEntryId أعلاه) مش قيد منفصل — هذا الحقل للتتبع/الحذف عند فك الترحيل بس.
  sourcePurchaseInvoiceLineId String?                      @unique
  // نفس المبدأ، لأصل أُنشئ من نافذة اختيار حساب أصول ثابتة داخل قيد يومية عادي (Phase F).
  sourceJournalEntryLineId    String?                      @unique
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  journalEntryLines JournalEntryLine[]

  @@unique([tenantId, companyId, assetNumber])
  @@map("fixed_assets")
}

model DepreciationRun {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month          String // YYYY-MM
  totalAmount    Decimal  @db.Decimal(18, 2)
  journalEntryId String?
  createdAt      DateTime @default(now())

  @@unique([tenantId, companyId, month])
  @@map("depreciation_runs")
}

// ---------------------------------------------------------------------------
// 4.8 شئون الموظفين
// ---------------------------------------------------------------------------

enum ContractType {
  unlimited
  limited
}

enum LeaveStatus {
  active
  onLeave
}

enum EmployeeStatus {
  active
  terminated
}

model Employee {
  id                        String         @id @default(cuid())
  tenantId                  String
  tenant                    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId                 String
  company                   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                      String
  jobTitle                  String?
  department                String?
  hireDate                  DateTime
  contractType              ContractType   @default(unlimited)
  contractEnd               DateTime?
  basicSalary               Decimal        @db.Decimal(18, 2)
  housingAllowance          Decimal        @default(0) @db.Decimal(18, 2)
  transportAllowance        Decimal        @default(0) @db.Decimal(18, 2)
  otherAllowance            Decimal        @default(0) @db.Decimal(18, 2)
  gosiApplicable            Boolean        @default(true)
  gosiAmount                Decimal?       @db.Decimal(18, 2)
  advances                  Decimal        @default(0) @db.Decimal(18, 2)
  otherDeductions           Decimal        @default(0) @db.Decimal(18, 2)
  nationality               String?
  dateOfBirth               DateTime?
  bankName                  String?
  bankAccount               String?
  leaveStatus               LeaveStatus    @default(active)
  lastLeaveReturnDate       DateTime?
  probationEndDate          DateTime?
  probationEvaluated        Boolean        @default(false)
  status                    EmployeeStatus @default(active)
  // --- بوابة الموظف (تطبيق الجوال) — تسجيل دخول منفصل تماماً عن حسابات User الإدارية ---
  phone                     String? // رقم جوال الموظف — قناة الدخول لبوابة الموظف (فريد ضمن المستأجر)
  pinHash                   String? // تجزئة bcrypt لرمز PIN (مطابق لأسلوب hashPassword)، لا يُخزَّن نصاً أبداً
  portalActive              Boolean        @default(false) // تفعّله الموارد البشرية صراحةً بعد تعيين الهاتف/PIN
  failedPortalLoginAttempts Int            @default(0)
  portalLockedUntil         DateTime?
  managerId                 String?
  manager                   Employee?      @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  // حساب تفصيلي مستقل (مستوى رابع) تحت مجموعة "ذمم الموظفين" (أصول متداولة) — يمثّل صافي الراتب
  // المستحق لهذا الموظف تحديداً (بدل الحساب المشترك "رواتب مستحقة للصرف"/"ذمم الموظفين -
  // مستحقات وإجازات" السابق). نفس مبدأ Customer.accountId/Supplier.accountId.
  accountId                 String?
  account                   Account?       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  documents         EmployeeDocument[]
  leaveRequests     LeaveRequest[]
  leaveSettlements  LeaveSettlement[]
  hrActions         HrAction[]
  journalEntryLines JournalEntryLine[]
  directReports     Employee[]                 @relation("EmployeeManager")
  attendanceRecords AttendanceRecord[]
  payrollComponents EmployeePayrollComponent[]
  advanceRecords    EmployeeAdvance[]
  // أصول محتفَظ بها كعهدة حالياً — تتبّع بسيط لمن يحمل الأصل الآن بلا أي أثر محاسبي (بعكس
  // EmployeeAdvance)؛ تاريخ العُهدة عبر الزمن مؤجَّل لمرحلة مستقبلية (AssetCustodyHistory).
  custodyAssets     FixedAsset[]               @relation("FixedAssetCustodian")

  @@unique([tenantId, phone])
  @@map("employees")
}

model EmployeeDocument {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String
  number     String?
  expiryDate DateTime?

  @@map("employee_documents")
}

enum LeaveRequestStatus {
  pending
  approved
  rejected
}

model LeaveRequest {
  id         String             @id @default(cuid())
  employeeId String
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String
  startDate  DateTime
  endDate    DateTime
  days       Int
  status     LeaveRequestStatus @default(pending)
  note       String?
  createdAt  DateTime           @default(now())

  @@map("leave_requests")
}

// حضور الموظف اليومي — سجل واحد لكل موظف لكل يوم تقويمي (تسجيل حضور/انصراف من بوابة الجوال).
// المرحلة الحالية تكتفي برصد "غياب تام" (لا يوجد سجل إطلاقاً لهذا اليوم) دون توقيتات دوام أو
// كشف تأخير/انصراف مبكر — يؤجَّل ذلك لمرحلة لاحقة عند إضافة جداول الورديات الرسمية.
model AttendanceRecord {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // منتصف الليل UTC لليوم التقويمي (بلا وقت) — مفتاح "يوم واحد" لكل موظف
  checkInAt  DateTime?
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([tenantId, companyId, date])
  @@map("attendance_records")
}

enum LeaveSettlementStatus {
  calculated
  disbursed
}

model LeaveSettlement {
  id                         String                @id @default(cuid())
  tenantId                   String
  tenant                     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId                 String
  employee                   Employee              @relation(fields: [employeeId], references: [id])
  leaveStartDate             DateTime
  monthAmount                Decimal               @db.Decimal(18, 2)
  daysWorked                 Decimal               @db.Decimal(6, 2)
  bonuses                    Decimal               @default(0) @db.Decimal(18, 2)
  deductions                 Decimal               @default(0) @db.Decimal(18, 2)
  ticketAmount               Decimal               @default(0) @db.Decimal(18, 2)
  visaAmount                 Decimal               @default(0) @db.Decimal(18, 2)
  accruedDays                Decimal               @db.Decimal(6, 2)
  netAmount                  Decimal               @db.Decimal(18, 2)
  journalEntryId             String?
  status                     LeaveSettlementStatus @default(calculated)
  disbursementMethod         String?
  disbursementDate           DateTime?
  disbursementJournalEntryId String?
  returnDate                 DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  @@map("leave_settlements")
}

// ---------------------------------------------------------------------------
// 4.9 إعدادات الرواتب المرنة — بنود قابلة للتعديل الكامل (Phase H) بدل الحقول الاثني عشر
// الثابتة سابقاً في WidePayrollRow. انظر src/lib/payrollEngine.ts لمنطق التقييم الفعلي،
// و/root/.claude/plans/shimmering-popping-thunder.md لتصميم بنية "الصيغة المركّبة" (formula).
// ---------------------------------------------------------------------------

// بند راتب واحد (إضافة أو خصم) — قابل للتعديل الكامل من شاشة "إعدادات الرواتب"، مع طريقة حساب
// مرنة (قيمة ثابتة / صيغة مركّبة تشمل النسبة المئوية كحالة خاصة بحدّ واحد بلا تحويل وحدة).
model PayrollComponent {
  id                       String   @id @default(cuid())
  tenantId                 String
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId                String
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                     String
  kind                     String // "addition" | "deduction"
  accountId                String
  account                  Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  calcMethod               String // "fixed" | "formula" — انظر PayrollFormula في payrollEngine.ts
  formula                  Json? // PayrollFormula — فقط عند calcMethod = "formula"
  // { unitType: "hour"|"day", referenceComponentIds: string[] } | null — يفعّل إدخال "تسوية شهرية"
  // (HrAction) كعدد وحدات (أيام/ساعات) بدل مبلغ جاهز، محسوبة بنفس منطق سعر الوحدة في formula.
  adjustmentUnitBasis      Json?
  allowsMonthlyAdjustments Boolean  @default(true)
  // يُطبَّق فقط على البنود المرتبطة مباشرة بمرتب الموظف الأساسي (تناسب تلقائي عند إجازة/عودة
  // منتصف الشهر) — يطابق منطق computeWidePayrollRow القديم (returningThisMonth).
  prorateOnPartialMonth    Boolean  @default(true)
  // "basicSalary"|"housingAllowance"|"transportAllowance"|"otherAllowance"|null — للبنود الأربعة
  // التي يعتمد عليها calcEOS/dailyRate مباشرة من أعمدة Employee الخام (hrCalculations.ts)؛ قيمتها
  // مرآة حيّة لعمود Employee المطابق بدل قيمة مستقلة، حفاظاً على تلك الحسابات القانونية الأخرى.
  sourceEmployeeField      String?
  isSystem                 Boolean  @default(false) // بنود مهاجَرة من النظام القديم — تُمنع من الحذف
  // مفتاح ثابت داخلي للبنود النظامية فقط (مثل "basic"/"gosi") — يسمح لسكريبت التعبئة الرجعية
  // وصيغ البنود الأخرى (كصيغة GOSI التي تشير لبند "الأساسي") بإيجاد بند نظامي بعينه لكل شركة
  // بشكل صامد أمام إعادة تسمية العرض (name) لاحقاً من واجهة الإعدادات. null لأي بند غير نظامي.
  systemKey                String?
  isActive                 Boolean  @default(true)
  sortOrder                Int      @default(0)
  appliesByDefault         Boolean  @default(true) // يُسند تلقائياً لكل موظف جديد
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  employeeLinks EmployeePayrollComponent[]
  hrActions     HrAction[]

  @@unique([companyId, systemKey])
  @@map("payroll_components")
}

// تعيين بند راتب لموظف معيّن — كل موظف قد تنطبق عليه بنود مختلفة، والقيمة الثابتة (عند
// calcMethod = "fixed" وبلا sourceEmployeeField) تُدخَل هنا خصيصاً لهذا الموظف.
model EmployeePayrollComponent {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  componentId String
  component   PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  fixedValue  Decimal?         @db.Decimal(18, 2)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  advance EmployeeAdvance?

  @@unique([employeeId, componentId])
  @@map("employee_payroll_components")
}

enum EmployeeAdvanceStatus {
  active
  settled
}

// سلفة/عهدة موظف — أُنشئت من نافذة اختيار حساب "عهدة/سلفة" داخل قيد يومي (Phase F)، أو من
// شاشة مخصَّصة لاحقاً. لو monthlyInstallment محدَّدة، تُنشئ بند راتب مخصَّص لهذه السلفة تحديداً
// (employeePayrollComponentId) بدل استخدام بند "سلف موظفين" العام المشترك — لأن
// EmployeePayrollComponent مقيَّد بـ @@unique([employeeId, componentId])، فبند مشترك واحد
// يمنع وجود أكثر من سلفة نشطة لنفس الموظف بجدولي تقسيط مختلفين في آن واحد؛ بند مخصَّص لكل سلفة
// يتفادى هذا القيد تماماً. null لعهدة نقدية عادية غير مُقسّطة (بلا تكامل مع الرواتب إطلاقاً).
model EmployeeAdvance {
  id                         String                    @id @default(cuid())
  tenantId                   String
  tenant                     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId                  String
  company                    Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId                 String
  employee                   Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // الحساب الفعلي (عهدة/سلفة هذا الموظف تحديداً) الذي رُحِّل عليه مبلغ السلفة.
  accountId                  String
  account                    Account                   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount                     Decimal                   @db.Decimal(18, 2)
  monthlyInstallment         Decimal?                  @db.Decimal(18, 2)
  // يبدأ = amount، يُنقَص كل تشغيل رواتب بمقدار الخصم الفعلي (Phase E) حتى يصل صفراً فتُصبح
  // status = settled ويُعطَّل employeePayrollComponent تلقائياً.
  remainingBalance           Decimal                   @db.Decimal(18, 2)
  startDate                  DateTime
  status                     EmployeeAdvanceStatus     @default(active)
  employeePayrollComponentId String?                   @unique
  employeePayrollComponent   EmployeePayrollComponent? @relation(fields: [employeePayrollComponentId], references: [id], onDelete: SetNull)
  // قيد الصرف الخاص بهذه السلفة — يُملأ فقط لو أُنشئت عبر مسار مستقل ينشئ قيده الخاص (Phase E)،
  // لا لو أُنشئت داخل سطر قيد يومية عام موجود بالفعل (عندها sourceJournalEntryLineId أدناه هو المرجع).
  journalEntryId             String?
  // يتتبّع سطر القيد الذي أنشأ هذه السلفة أول مرة (أثر مراجعة) — null لو أُنشئت من شاشة مخصَّصة.
  sourceJournalEntryLineId   String?                   @unique
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  journalEntryLines JournalEntryLine[]
  deductions        EmployeeAdvanceDeduction[]

  @@map("employee_advances")
}

// سجل خصم فعلي لسلفة ضمن تشغيل رواتب مُرحَّل واحد (Phase E) — يُنشأ فقط عند ترحيل الكشف (لا وقت
// المعاينة)، ويُستخدَم عند فك الترحيل لإرجاع remainingBalance بدقة (وإعادة تفعيل السلفة/البند لو
// كانت قد استقرت "settled" بسبب هذا الخصم بالذات) بدل إعادة حسابه تخمينياً من الحالة الحالية.
model EmployeeAdvanceDeduction {
  id                String          @id @default(cuid())
  employeeAdvanceId String
  employeeAdvance   EmployeeAdvance @relation(fields: [employeeAdvanceId], references: [id], onDelete: Cascade)
  payrollRunId      String
  payrollRun        PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  amount            Decimal         @db.Decimal(18, 2)
  createdAt         DateTime        @default(now())

  @@unique([employeeAdvanceId, payrollRunId])
  @@map("employee_advance_deductions")
}

// إعدادات رواتب عامة لكل شركة — الساعات/الأيام القياسية للشهر (أساس حساب سعر الوحدة في
// الصيغ المركّبة)، وترتيب/تسمية أعمدة كشف الرواتب المطبوع والمعروض.
model PayrollSettings {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId             String   @unique
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  standardHoursPerMonth Decimal  @default(240) @db.Decimal(6, 2)
  standardDaysPerMonth  Decimal  @default(30) @db.Decimal(6, 2)
  payslipColumns        Json // [{ componentId: string | null (null = "net"/"gross" محسوب), label: string }]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("payroll_settings")
}

enum ReportScheduleFrequency {
  daily
  weekly
  monthly
}

// جدولة إرسال دوري تلقائي للتقارير المالية (ميزان المراجعة، قائمة الدخل، المركز المالي،
// التقرير الشهري الشامل) عبر البريد الإلكتروني لمدير الحسابات — سجل واحد فقط لكل شركة (@unique
// على companyId)، بنفس نمط PayrollSettings أعلاه. المُرسِل الفعلي في
// src/lib/reportScheduler.ts يفحص كل الجدولات المفعّلة كل ساعة ويقارن lastSentPeriodKey لتفادي
// إرسال نفس الفترة مرتين حتى لو أُعيد تشغيل الخادم أثناء نفس الساعة المستهدفة.
//
// dayOfWeek/dayOfMonth/hourKsa الثلاثة بتوقيت السعودية المحلي (AST، UTC+3 ثابت بلا توقيت صيفي)
// دائماً — وليس UTC — حتى لا تُضطر أي جهة (الواجهة أو المُجدوِل) لتحويل يوم التقويم عند عبور
// منتصف الليل بين المنطقتين (كانت هذه بالضبط مشكلة تصميم UTC السابق: تحويل الساعة فقط دون
// اليوم المرافق لها ينتج توقيتاً خاطئاً بيوم كامل لأي جدولة بين الساعة 00:00 و02:59 بتوقيت
// السعودية). المُجدوِل يحوّل "الآن" (UTC) لتوقيت السعودية بإضافة 3 ساعات فقط قبل المقارنة، فلا
// حاجة لأي تحويل معاكس هنا أو في الواجهة.
model ReportSchedule {
  id                          String                  @id @default(cuid())
  tenantId                    String
  tenant                      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId                   String                  @unique
  company                     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  frequency                   ReportScheduleFrequency @default(monthly)
  dayOfWeek                   Int                     @default(0) // 0=الأحد..6=السبت (بتوقيت السعودية)، يُستخدَم فقط مع weekly
  dayOfMonth                  Int                     @default(1) // 1-28 (بتوقيت السعودية)، يُستخدَم فقط مع monthly (الأشهر الأقصر من 31 يوماً تُرسَل في آخر يوم لها بدل تخطّي الشهر بالكامل)
  hourKsa                     Int                     @default(6) // ساعة الإرسال بتوقيت السعودية المحلي (AST، UTC+3 ثابت) — 0-23
  includeComprehensiveMonthly Boolean                 @default(true)
  includeTrialBalance         Boolean                 @default(true)
  includeIncomeStatement      Boolean                 @default(true)
  includeBalanceSheet         Boolean                 @default(true)
  // فارغة = تُرسَل تلقائياً لكل مستخدمي هذه الشركة (companyScope="all" أو = هذه الشركة) بدور
  // admin/finance_manager/super_admin، بدل تكرار إدخال نفس القائمة يدوياً في كل شركة.
  recipientEmails             String[]                @default([])
  enabled                     Boolean                 @default(true)
  lastSentAt                  DateTime?
  // مفتاح الفترة المُرسَلة آخر مرة (مثلاً "2026-08-11" يومياً، "2026-W32" أسبوعياً، "2026-08"
  // شهرياً) — أدقّ من مقارنة lastSentAt بالتاريخ الحالي فقط، ويمنع إرسال مزدوج لنفس الفترة عند
  // إعادة تشغيل الخادم أو تداخل عدة نبضات cron خلال نفس الساعة المستهدفة.
  lastSentPeriodKey           String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  @@map("report_schedules")
}

model HrAction {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee          @relation(fields: [employeeId], references: [id])
  month       String // YYYY-MM
  actionType  String
  // البند المستهدَف من "بنود الرواتب" — يُستبدَل تدريجياً actionType الحر السابق؛ Nullable مؤقتاً
  // حتى تكتمل التعبئة الرجعية (backfillPayrollComponents.ts)، ثم إلزامي.
  componentId String?
  component   PayrollComponent? @relation(fields: [componentId], references: [id])
  value       Decimal           @db.Decimal(18, 2)
  note        String?
  batchId     String?
  createdAt   DateTime          @default(now())

  @@map("hr_actions")
}

model PayrollRun {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month          String // YYYY-MM
  employeeIds    String[]
  status         JournalStatus @default(draft)
  overrides      Json          @default("{}")
  journalEntryId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  advanceDeductions EmployeeAdvanceDeduction[]

  @@unique([tenantId, companyId, month])
  @@map("payroll_runs")
}

// مرفقات المستندات المؤيدة لأي معاملة — موديول عام قابل لإعادة الاستخدام عبر كل الشاشات
// (قيود، فواتير، مردودات، سندات، كشوف رواتب، تسويات إجازة، أصول ثابتة...). entityType/entityId
// مرجع منطقي حر (String وليس علاقة FK صارمة) على غرار sourceModule/sourceId في JournalEntry،
// حتى لا يتطلب أي كيان جديد تعديلاً في هذا المخطط. fileKey هو مسار الملف الدائم داخل حاوية
// R2 — رابط العرض/التنزيل الفعلي (presigned URL) يُولَّد عند الطلب فقط (انظر src/lib/storage.ts)
// ولا يُخزَّن بشكل دائم، لأنه صالح لفترة محدودة ولأن حاوية R2 غير مُعلَنة كعامة (public).
model Attachment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  fileName   String
  fileKey    String
  fileSize   Int
  mimeType   String
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("attachments")
}
