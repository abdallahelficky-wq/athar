    "about": {
      "eyebrow": "About us",
      "title": "About Athar Accounting",
      "text": "Athar Accounting is a cloud accounting system built specifically for the Saudi business environment, aimed at simplifying day-to-day accounting work for business owners and accountants alike. The system is designed to cover the full workflow of any business or group of companies: from the accounting foundation (chart of accounts and daily journal entries), through sales, purchases, inventory and fixed assets, to managing employees, their payroll and entitlements. All of this with full compliance with the Zakat, Tax and Customs Authority's e-invoicing requirements, and accurate financial reports that reflect the true picture of business performance at any moment."
    },
    "why": {
      "eyebrow": "Why Athar Accounting",
      "title": "Designed to fit the way you work",
      "items": [
        { "title": "ZATCA compliant", "desc": "Electronic tax invoices (standard and simplified) with a real QR code, built from the ground up to meet the requirements of the Zakat, Tax and Customs Authority." },
        { "title": "A whole group in one place", "desc": "Manage all your companies from a single screen, with complete data separation per company and consolidated reports for the whole group." },
        { "title": "A complete employee lifecycle", "desc": "From hiring and leave to payroll and end-of-service benefits, calculated according to Saudi labor law." },
        { "title": "Instant financial reports", "desc": "The trial balance, income statement and balance sheet update live with every entry and invoice you record." },
        { "title": "Integrated sales and purchases cycle", "desc": "From quotation to invoice to receipt, and from purchase order to supplier invoice, with full automatic accounting links." },
        { "title": "An interface designed for your market", "desc": "Built from scratch to fit how accountants in the Saudi market actually work, not an interface translated from a foreign system." }
      ]
